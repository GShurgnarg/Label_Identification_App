import os
import io
import json
from flask import Flask, request, jsonify, send_from_directory
from google import genai
from google.genai import types
from PIL import Image

app = Flask(__name__, static_folder='.')
client = genai.Client()

PROMPT_INSTRUCTIONS = """
Extract data from this alcohol label image. Return data strictly as a valid JSON object matching the formatting below.
For the 'government_health_warning', capture the exact raw casing and markdown bold markers (e.g. '**GOVERNMENT WARNING:**') exactly as they are printed on the physical label.

{
  "brand_name": "string or null",
  "class_type_designation": "string or null",
  "alcohol_content": "string or null",
  "net_contents": "string or null",
  "bottler_producer_details": {
    "name": "string or null",
    "address": "string or null"
  },
  "country_of_origin": "string or null",
  "government_health_warning": "string or null"
}
"""

def clean_text_for_exact_match(val):
    """Normalizes whitespace and casing variations for standard key comparisons."""
    if not val:
        return ""
    return " ".join(str(val).strip().lower().split())

@app.route('/')
def index():
    return send_from_directory('.', 'index.html')

@app.route('/api/verify-label', methods=['POST'])
def verify_label():
    if 'image' not in request.files or 'expected_data' not in request.files:
        return jsonify({"error": "Missing image file or expected_data description file."}), 400

    image_file = request.files['image']
    expected_file = request.files['expected_data']

    try:
        # 1. Parse Expected JSON Profile Data
        try:
            expected_json = json.loads(expected_file.read().decode('utf-8'))
        except Exception:
            return jsonify({"error": "Expected data file must be valid JSON matching your label profile schema."}), 400

        # 2. Process Image through Gemini API
        image_bytes = image_file.read()
        pil_image = Image.open(io.BytesIO(image_bytes))
        
        response = client.models.generate_content(
            model='gemini-2.5-flash',
            contents=[pil_image, PROMPT_INSTRUCTIONS],
            config=types.GenerateContentConfig(response_mime_type="application/json")
        )
        
        extracted_text = response.text.strip()
        if extracted_text.startswith("```"):
            extracted_text = extracted_text.strip("```").strip("json").strip()
            
        extracted_json = json.loads(extracted_text)

        # 3. Structural Comparison Engine (Exact Value Matching)
        mismatches = {}
        fields_to_compare = [
            'brand_name', 'class_type_designation', 'alcohol_content', 
            'net_contents', 'country_of_origin'
        ]

        for field in fields_to_compare:
            exp_val = expected_json.get(field)
            ext_val = extracted_json.get(field)
            if clean_text_for_exact_match(exp_val) != clean_text_for_exact_match(ext_val):
                mismatches[field] = {"expected": exp_val, "extracted_from_photo": ext_val}

        # Handle nested Producer dict safely
        exp_prod = expected_json.get('bottler_producer_details', {}) or {}
        ext_prod = extracted_json.get('bottler_producer_details', {}) or {}
        for subfield in ['name', 'address']:
            ev = exp_prod.get(subfield)
            xv = ext_prod.get(subfield)
            if clean_text_for_exact_match(ev) != clean_text_for_exact_match(xv):
                mismatches[f"bottler_producer_details.{subfield}"] = {"expected": ev, "extracted_from_photo": xv}

        # 4. Strict TTB Compliance Logic (All-Caps & Bold Checks)
        gov_warning_text = extracted_json.get('government_health_warning', '') or ''
        
        # Check if the header itself is marked bold natively via markdown wrappers (**TEXT**)
        has_bold_markers = "**GOVERNMENT WARNING:" in gov_warning_text or "__GOVERNMENT WARNING:" in gov_warning_text
        
        # Check if the string "GOVERNMENT WARNING:" is explicitly capitalized completely
        is_uppercase = "GOVERNMENT WARNING:" in gov_warning_text.upper() and "government warning" not in gov_warning_text

        ttb_compliance = {
            "raw_extracted_warning_string": gov_warning_text,
            "contains_bold_styling_indicators": has_bold_markers,
            "header_is_all_caps": is_uppercase,
            "government_warning_compliant": has_bold_markers and is_uppercase
        }

        return jsonify({
            "mismatches_found": len(mismatches),
            "mismatch_details": mismatches,
            "ttb_compliance": ttb_compliance,
            "full_extracted_data": extracted_json
        }), 200

    except Exception as e:
        return jsonify({"error": f"Internal process crash: {str(e)}"}), 500

if __name__ == '__main__':
    app.run(host='0.0.0.0', port=5000, debug=True)
