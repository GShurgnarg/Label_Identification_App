import os
from flask import Flask, request, jsonify, send_from_directory
from google import genai
from google.genai import types
from PIL import Image
import io

app = Flask(__name__, static_folder='.')

# Initialize the Gemini Client (Make sure GEMINI_API_KEY is set in your environment)
client = genai.Client()

PROMPT_INSTRUCTIONS = """
You are an expert AI data extraction tool specializing in government beverage regulations (TTB standards). 
Analyze the provided image of an alcohol beverage label and extract the following fields. 

Return the response STRICTLY as a valid JSON object matching this schema. If a field cannot be found, set its value to null.

{
  "brand_name": "The trade name or prominent brand name under which the product is sold.",
  "class_type_designation": "The specific designation (e.g., 'Bourbon Whiskey', 'Red Wine', 'India Pale Ale').",
  "alcohol_content": "The alcohol by volume percentage (ABV). Account for standard wine/beer variations if stated as a range or proof.",
  "net_contents": "The fluid volume statement (e.g., '750 ml', '12 FL. OZ.').",
  "bottler_producer_details": {
    "name": "Name of the company",
    "address": "Full physical address of the bottler or producer as written"
  },
  "country_of_origin": "The country where the product was produced if it is explicitly noted as imported.",
  "government_health_warning": "The text following the mandatory 'GOVERNMENT WARNING:' statement regarding pregnancy, operation of machinery, and health problems."
}
"""

@app.route('/')
def index():
    return send_from_directory('.', 'index.html')

@app.route('/api/analyze-label', methods=['POST'])
def analyze_label():
    if 'image' not in request.files:
        return jsonify({"error": "No image file provided"}), 400
        
    file = request.files['image']
    try:
        # Open and compress the image safely in memory
        image_bytes = file.read()
        pil_image = Image.open(io.BytesIO(image_bytes))
        
        # Call Gemini's vision capability 
        response = client.models.generate_content(
            model='gemini-2.5-flash',
            contents=[pil_image, PROMPT_INSTRUCTIONS],
            config=types.GenerateContentConfig(
                response_mime_type="application/json"
            )
        )
        
        # Return the structured JSON directly to the frontend
        return app.response_class(
            response=response.text,
            status=200,
            mimetype='application/json'
        )
        
    except Exception as e:
        return jsonify({"error": str(e)}), 500

if __name__ == '__main__':
    # Run server locally
    app.run(host='0.0.0.0', port=5000, debug=True)
