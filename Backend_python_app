import os
import io
import json
from flask import Flask, request, jsonify, send_from_directory
from google import genai
from google.genai import types
from google.genai.errors import APIError
from PIL import Image

app = Flask(__name__, static_folder='.')

# Fallback/verification check for safety: fail early if environment variable is missing
GEMINI_KEY = os.environ.get("GEMINI_API_KEY")
if not GEMINI_KEY:
    print("CRITICAL WARNING: 'GEMINI_API_KEY' environment variable is not set.")

# Initialize API Client safely
try:
    client = genai.Client()
except Exception as init_err:
    client = None
    print(f"Failed to initialize Gemini Client: {init_err}")

PROMPT_INSTRUCTIONS = """
You are an expert AI data extraction tool specializing in government beverage regulations (TTB standards). 
Analyze the provided image of an alcohol beverage label and extract the following fields. 

Return the response STRICTLY as a valid JSON object matching this schema. If a field cannot be found, set its value to null.
Do not wrap your response in markdown formatting or backticks.

{
  "brand_name": "string or null",
  "class_type_designation": "string or null",
  "alcohol_content": "string or null",
  "net_contents": "string or null",
  "bottler_producer_details": {
    "name": "string or null",
    "address": "string or null"
  },
  "country_of_origin": "string or null",
  "government_health_warning": "string or null"
}
"""

@app.route('/')
def index():
    return send_from_directory('.', 'index.html')

@app.route('/api/analyze-label', methods=['POST'])
def analyze_label():
    # 1. Handle against empty initialization
    if not client:
        return jsonify({"error": "AI Backend Client setup is incomplete. Check server logs."}), 500

    # 2. Verify attachment exists in request body
    if 'image' not in request.files:
        return jsonify({"error": "No image attachment payload found in the request."}), 400
        
    file = request.files['image']
    
    # 3. Handling against empty submission strings
    if file.filename == '':
        return jsonify({"error": "Empty file submitted. Please choose or capture an image."}), 400

    try:
        # 4. Handle PIL decoding exceptions (e.g. user uploaded a corrupted file or an invalid filetype)
        try:
            image_bytes = file.read()
            pil_image = Image.open(io.BytesIO(image_bytes))
            # Verify readable image format through basic transformation
            pil_image.verify() 
            # Re-open because verify() closes the stream context
            pil_image = Image.open(io.BytesIO(image_bytes))
        except Exception:
            return jsonify({"error": "The uploaded file is not a valid or supported format."}), 400
        
        # 5. Connect to Google GenAI with exception blocks
        try:
            response = client.models.generate_content(
                model='gemini-2.5-flash',
                contents=[pil_image, PROMPT_INSTRUCTIONS],
                config=types.GenerateContentConfig(
                    response_mime_type="application/json"
                )
            )
        except APIError as api_err:
            # Catch direct upstream rate limiting, quota overages, or downtime
            return jsonify({"error": f"Upstream AI service error: {api_err.message}"}), 502
        except Exception as general_api_err:
            return jsonify({"error": f"Failed contacting the cloud inference service: {str(general_api_err)}"}), 500

        # 6. Handle and structure the structural JSON responses
        cleaned_text = response.text.strip()
        
        # Remove accidental markdown wrappers if the AI enters them
        if cleaned_text.startswith("```"):
            cleaned_text = cleaned_text.strip("```").strip("json").strip()

        try:
            parsed_json = json.loads(cleaned_text)
            return jsonify(parsed_json), 200
        except json.JSONDecodeError:
            # If text data failed structured validation
            return jsonify({
                "error": "The AI read the label but returned an invalid JSON data structure.",
                "raw_output": cleaned_text
            }), 522
        
    except Exception as server_err:
        # Global block to keep app from crashing
        return jsonify({"error": f"An unhandled internal server error occurred: {str(server_err)}"}), 500

if __name__ == '__main__':
    app.run(host='0.0.0.0', port=5000, debug=True)
